generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleType {
  admin
  farmer
}

enum UserStatus {
  pending
  active
}

enum SeasonStatus {
  active
  harvested
  closed
}

enum ActivityType {
  sowing
  fertilizing
  irrigation
  spraying
  weeding
  harvesting
  other
}

enum ExpenseCategory {
  inputs
  labor
  machinery
  transport
  rent
  other
}

enum UnitType {
  kg
  ton
  liter
  piece
  sack
  packet
  hour
  day
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String     @db.VarChar(120)
  email               String     @unique @db.VarChar(160)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  role                RoleType   @default(farmer)
  status              UserStatus @default(pending)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  verificationSentAt  DateTime?  @map("verification_sent_at")
  passwordResetSentAt DateTime?  @map("password_reset_sent_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  farms        Farm[]
  reminders    Reminder[]
  createdCrops Crop[]     @relation("UserCrops")

  @@map("users")
}

model Farm {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(120)
  location  String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcels Parcel[]

  @@unique([userId, name])
  @@map("farms")
}

model Parcel {
  id        String   @id @default(uuid()) @db.Uuid
  farmId    String   @map("farm_id") @db.Uuid
  name      String   @db.VarChar(120)
  areaHa    Decimal  @map("area_ha") @db.Decimal(10, 4)
  soilType  String?  @map("soil_type") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farm        Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropSeasons CropSeason[]

  @@map("parcels")
}

model Crop {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique @db.VarChar(100)
  category     String?   @db.VarChar(80)
  standardUnit UnitType? @map("standard_unit")
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  // null createdById = AgroDitari default crop; set = user-created. Crops
  // are always global (visible to everyone), never ownership-filtered.
  createdBy   User?        @relation("UserCrops", fields: [createdById], references: [id], onDelete: SetNull)
  cropSeasons CropSeason[]

  @@map("crops")
}

model CropSeason {
  id                  String       @id @default(uuid()) @db.Uuid
  parcelId            String       @map("parcel_id") @db.Uuid
  cropId              String       @map("crop_id") @db.Uuid
  season              String       @db.VarChar(60)
  status              SeasonStatus @default(active)
  sowingDate          DateTime?    @map("sowing_date") @db.Date
  expectedHarvestDate DateTime?    @map("expected_harvest_date") @db.Date
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  parcel     Parcel     @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  crop       Crop       @relation(fields: [cropId], references: [id])
  activities Activity[]
  expenses   Expense[]
  harvests   Harvest[]
  reminders  Reminder[]

  @@map("crop_seasons")
}

model Activity {
  id           String       @id @default(uuid()) @db.Uuid
  cropSeasonId String       @map("crop_season_id") @db.Uuid
  activityType ActivityType @map("activity_type")
  date         DateTime     @db.Date
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  cropSeason CropSeason @relation(fields: [cropSeasonId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model Input {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  category  String?  @db.VarChar(80)
  unit      UnitType
  unitPrice Decimal? @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  expenses Expense[]

  @@map("inputs")
}

model Expense {
  id           String          @id @default(uuid()) @db.Uuid
  cropSeasonId String          @map("crop_season_id") @db.Uuid
  inputId      String?         @map("input_id") @db.Uuid
  category     ExpenseCategory
  description  String?         @db.VarChar(200)
  quantity     Decimal?        @db.Decimal(12, 3)
  unitPrice    Decimal?        @map("unit_price") @db.Decimal(12, 2)
  amount       Decimal         @db.Decimal(12, 2)
  date         DateTime        @db.Date
  createdAt    DateTime        @default(now()) @map("created_at")

  cropSeason CropSeason @relation(fields: [cropSeasonId], references: [id], onDelete: Cascade)
  input      Input?     @relation(fields: [inputId], references: [id])

  @@map("expenses")
}

model Harvest {
  id           String   @id @default(uuid()) @db.Uuid
  cropSeasonId String   @map("crop_season_id") @db.Uuid
  quantity     Decimal  @db.Decimal(12, 3)
  unit         UnitType
  unitPrice    Decimal? @map("unit_price") @db.Decimal(12, 2)
  revenue      Decimal? @db.Decimal(12, 2)
  date         DateTime @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  cropSeason CropSeason @relation(fields: [cropSeasonId], references: [id], onDelete: Cascade)

  @@map("harvests")
}

model Reminder {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  cropSeasonId String?  @map("crop_season_id") @db.Uuid
  title        String   @db.VarChar(160)
  description  String?
  dueDate      DateTime @map("due_date") @db.Date
  isDone       Boolean  @default(false) @map("is_done")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropSeason CropSeason? @relation(fields: [cropSeasonId], references: [id], onDelete: SetNull)

  @@map("reminders")
}
