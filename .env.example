# Kopjo këtë skedar si .env dhe plotëso vlerat e tua.
# Copy this file to .env and fill in your own values. Never commit .env.

# Postgres (Supabase) — pooled connection for the app (port 6543, pgbouncer).
DATABASE_URL=

# Postgres (Supabase) — direct connection for Prisma migrations (port 5432).
DIRECT_URL=

# Auth.js v5 signing secret. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Required in production so Auth.js trusts the deployment's host header.
AUTH_TRUST_HOST=true

# Base URL of the app, used to build links in emails (verification, password
# reset, reminder digest). Localhost in dev; set to the real deployed URL in
# production.
APP_URL=http://localhost:3000

# Secret that authorizes the /api/cron/reminders-digest route. Generate with:
# openssl rand -base64 33
CRON_SECRET=

# Gmail SMTP credentials (Nodemailer). Optional in dev — without these, emails
# are logged to the console instead of sent.
MAIL_USERNAME=
MAIL_PASSWORD=

# "From" address for outgoing email. Optional — falls back to MAIL_USERNAME.
EMAIL_FROM=

# Contact address shown to a user whose account was disabled by an admin.
# Public (NEXT_PUBLIC_) since it's rendered on the login page. No support
# desk exists for this project — set this to whichever inbox the project
# owner actually checks.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Upstash Redis (REST API) for rate limiting. Optional in dev — without these,
# rate limiting is disabled (always allows).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Superadmin account, seeded (or updated) by `npm run seed:superadmin`. Never
# hardcode these — set them here, run the seed script, then you may rotate
# SUPERADMIN_PASSWORD and re-run any time to change the login password.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Superadmin